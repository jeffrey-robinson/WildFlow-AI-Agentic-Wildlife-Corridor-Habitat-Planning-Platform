{
  "name": "wildflow-ai",
  "version": "1.0.0",
  "description": "WildFlow AI — Agentic Wildlife Corridor & Habitat Planning Platform",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "start": "npm run start --workspace=server",
    "start:server": "npm run start --workspace=server",
    "start:client": "npm run start --workspace=client",
    "build": "npm run build --workspace=client",
    "build:server": "npm run build --workspace=server",
    "build:client": "npm run build --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan.bold,magenta.bold\" \"npm run dev:server\" \"npm run dev:client\"",
    "seed": "npm run seed --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
